function TrafficVisualizer({
  stats,
}: {
  stats: {
    download: number;
    upload: number;
  };
}) {
  const bars = useMemo(
    () =>
      Array.from({ length: 34 }, (_, index) => {
        const wave = Math.sin(index / 2.6);
        const boost = Math.max(0, Math.sin(index / 1.8)) * 0.25;
        return clamp(0.24 + wave * 0.17 + boost + rand(-0.06, 0.06), 0.08, 0.95);
      }),
    [stats.download],
  );

  return (
    <>
      <div className="traffic-readouts">
        <StatMini
          label="DOWNLOAD"
          value={formatMbps(stats.download)}
          icon={ArrowDown}
        />
        <StatMini
          label="UPLOAD"
          value={formatMbps(stats.upload)}
          icon={ArrowUp}
        />
      </div>

      <div className="traffic-chart">
        <div className="chart-gridline line-1" />
        <div className="chart-gridline line-2" />
        <div className="chart-gridline line-3" />

        <div className="traffic-bars">
          {bars.map((height, index) => (
            <div
              className="traffic-bar"
              key={index}
              style={{ height: `${height * 100}%` }}
            >
              <span />
            </div>
          ))}
        </div>
      </div>

      <div className="traffic-axis">
        <span>60s ago</span>
        <span>30s</span>
        <span>NOW</span>
      </div>
    </>
  );
}

