function App() {
  const forceFirstBoot =
    new URLSearchParams(window.location.search).get("firstboot") === "1";

  const [setupComplete, setSetupComplete] = useState(
    () =>
      !forceFirstBoot &&
      localStorage.getItem("quantumgrid-setup-complete") === "1",
  );

  const [setupStep, setSetupStep] = useState<SetupStep>(
    forceFirstBoot ? "welcome" : "done",
  );

  const [loginUsername, setLoginUsername] = useState(
    () => localStorage.getItem("quantumgrid-username") || "",
  );

  const [accountUsername, setAccountUsername] = useState(
    () => localStorage.getItem("quantumgrid-username") || "",
  );

  const [accountPassword, setAccountPassword] = useState("");
  const [accountConfirm, setAccountConfirm] = useState("");
  const [wifiSsid, setWifiSsid] = useState("QuantumGrid");
  const [wifiPassword, setWifiPassword] = useState("");
  const [wanType, setWanType] = useState<"dhcp" | "pppoe" | "static">("dhcp");

  const [loggedIn, setLoggedIn] = useState(false);
  const [loginPassword, setLoginPassword] = useState("");
  const [loginError, setLoginError] = useState("");

  const [page, setPage] = useState<Page>("dashboard");
  const [collapsed, setCollapsed] = useState(false);
  const [mobileNav, setMobileNav] = useState(false);

  const [stats, setStats] = useState({
    latency: 8,
    download: 942,
    upload: 41,
    loss: 0,
    jitter: 1.1,
    cpu: 21,
    temp: 51,
    ram: 34,
    wanUp: true,
  });

  const refreshStats = useCallback(() => {
    setStats((current) => ({
      ...current,
      latency: clamp(current.latency + rand(-2.5, 2.5), 5, 18),
      download: clamp(current.download + rand(-45, 45), 720, 1100),
      upload: clamp(current.upload + rand(-7, 7), 28, 75),
      loss: clamp(current.loss + rand(-0.08, 0.08), 0, 0.6),
      jitter: clamp(current.jitter + rand(-0.35, 0.35), 0.3, 3.5),
      cpu: clamp(current.cpu + rand(-4, 4), 8, 55),
      temp: clamp(current.temp + rand(-0.8, 0.8), 43, 67),
      ram: clamp(current.ram + rand(-2, 2), 24, 58),
    }));
  }, []);

  useEffect(() => {
    if (!setupComplete || !loggedIn) return;

    const interval = window.setInterval(refreshStats, 3000);
    return () => window.clearInterval(interval);
  }, [setupComplete, loggedIn, refreshStats]);

  const completeSetup = () => {
    localStorage.setItem("quantumgrid-setup-complete", "1");
    localStorage.setItem("quantumgrid-username", accountUsername.trim());
    localStorage.setItem("quantumgrid-wifi-ssid", wifiSsid);
    localStorage.setItem("quantumgrid-wan-type", wanType);

    setLoginUsername(accountUsername.trim());
    setSetupComplete(true);
    setSetupStep("done");
  };

  const login = () => {
    const savedUsername =
      localStorage.getItem("quantumgrid-username") || accountUsername;

    if (
      loginUsername.trim() === savedUsername &&
      loginPassword === accountPassword
    ) {
      setLoggedIn(true);
      setLoginError("");
      setLoginPassword("");
      return;
    }

    /*
     * Development fallback:
     * If the original account was created before refresh/reload and the
     * plaintext password is no longer in this running session, the UI
     * accepts the typed development password "quantumgrid".
     *
     * Replace this with backend authentication before production firmware.
     */
    if (loginUsername.trim() === savedUsername && loginPassword === "quantumgrid") {
      setLoggedIn(true);
      setLoginError("");
      setLoginPassword("");
      return;
    }

    setLoginError("Incorrect username or password.");
  };

  const renderPage = () => {
    switch (page) {
      case "dashboard":
        return <DashboardPage stats={stats} onRefresh={refreshStats} />;
      case "gaming":
        return <GamingPage stats={stats} />;
      case "devices":
        return <DevicesPage />;
      case "wifi":
        return <WifiPage />;
      case "5g":
        return <FiveGPage />;
      case "network":
        return <NetworkPage />;
      case "security":
        return <SecurityPage />;
      case "diagnostics":
        return <DiagnosticsPage stats={stats} onRun={refreshStats} />;
      case "analytics":
        return <AnalyticsPage />;
      case "system":
        return <SystemPage stats={stats} />;
      case "advanced":
        return <AdvancedPage />;
      default:
        return <ModulePageFallback page={page} />;
    }
  };

  if (!setupComplete || !loggedIn) {
    if (setupStep === "welcome") {
      return <WelcomeScreen onNext={() => setSetupStep("account")} />;
    }

    if (setupStep === "account") {
      return (
        <AccountScreen
          username={accountUsername}
          setUsername={setAccountUsername}
          password={accountPassword}
          setPassword={setAccountPassword}
          confirm={accountConfirm}
          setConfirm={setAccountConfirm}
          onBack={() => setSetupStep("welcome")}
          onNext={() => setSetupStep("wifi")}
        />
      );
    }

    if (setupStep === "wifi") {
      return (
        <WifiSetupScreen
          ssid={wifiSsid}
          setSsid={setWifiSsid}
          password={wifiPassword}
          setPassword={setWifiPassword}
          onBack={() => setSetupStep("account")}
          onNext={() => setSetupStep("wan")}
        />
      );
    }

    if (setupStep === "wan") {
      return (
        <WanSetupScreen
          type={wanType}
          setType={setWanType}
          onBack={() => setSetupStep("wifi")}
          onNext={completeSetup}
        />
      );
    }

    return (
      <LoginScreen
        username={loginUsername}
        password={loginPassword}
        setPassword={setLoginPassword}
        onLogin={login}
        error={loginError}
      />
    );
  }

  const grouped = {
    overview: navItems.filter((item) => item.section === "overview"),
    network: navItems.filter((item) => item.section === "network"),
    system: navItems.filter((item) => item.section === "system"),
  };

  return (
    <div className={`app ${collapsed ? "sidebar-collapsed" : ""}`}>
      <div className="ambient ambient-red" />
      <div className="ambient ambient-blue" />

      <aside className={`sidebar ${mobileNav ? "sidebar-open" : ""}`}>
        <div className="brand">
          <div className="brand-logo">Q</div>

          {!collapsed && (
            <div>
              <div className="brand-name">QUANTUMGRID</div>
              <div className="brand-subtitle">NETWORK OS</div>
            </div>
          )}

          <button
            className="mobile-close"
            onClick={() => setMobileNav(false)}
          >
            <X size={18} />
          </button>
        </div>

        <div className="side-scroll">
          <nav className="nav">
            <NavGroup
              title="Overview"
              items={grouped.overview}
              page={page}
              collapsed={collapsed}
              onSelect={(id) => {
                setPage(id);
                setMobileNav(false);
              }}
            />

            <NavGroup
              title="Network"
              items={grouped.network}
              page={page}
              collapsed={collapsed}
              onSelect={(id) => {
                setPage(id);
                setMobileNav(false);
              }}
            />

            <NavGroup
              title="System"
              items={grouped.system}
              page={page}
              collapsed={collapsed}
              onSelect={(id) => {
                setPage(id);
                setMobileNav(false);
              }}
            />
          </nav>
        </div>

        <div className="sidebar-bottom">
          {!collapsed && (
            <div className="router-card">
              <div className="router-icon">
                <Router size={18} />
              </div>

              <div>
                <strong>AW1000</strong>
                <span>IPQ807x PLATFORM</span>
              </div>

              <StatusDot />
            </div>
          )}

          {collapsed && (
            <div className="router-card router-card-collapsed">
              <Router size={18} />
              <StatusDot />
            </div>
          )}
        </div>
      </aside>

      <main className="main">
        <header className="topbar">
          <div className="topbar-left">
            <button
              className="mobile-menu"
              onClick={() => setMobileNav(true)}
            >
              <Menu size={20} />
            </button>

            <button
              className="collapse-button"
              onClick={() => setCollapsed((value) => !value)}
              title={collapsed ? "Expand sidebar" : "Collapse sidebar"}
            >
              <Menu size={18} />
            </button>

            <div className="breadcrumb">
              QUANTUMGRID
              <ChevronRight size={14} />
              <span>{page.toUpperCase()}</span>
            </div>
          </div>

          <div className="topbar-right">
            <StatusBadge>SYSTEM OPTIMAL</StatusBadge>

            <button
              className="refresh-button"
              onClick={refreshStats}
              title="Refresh telemetry"
            >
              <RefreshCw size={17} />
            </button>

            <button className="icon-button" title="Security">
              <Lock size={16} />
            </button>
          </div>
        </header>

        <div className="content">{renderPage()}</div>

        <footer className="footer">
          <span>QUANTUMGRID OS</span>
          <span>AW1000 • IPQ807x</span>
          <span>Development Build</span>
        </footer>
      </main>
    </div>
  );
}

function NavGroup({
  title,
  items,
  page,
  collapsed,
  onSelect,
}: {
  title: string;
  items: NavItem[];
  page: Page;
  collapsed: boolean;
  onSelect: (id: Page) => void;
}) {
  return (
    <div className="nav-group">
      {!collapsed && <div className="nav-title">{title}</div>}

      {items.map(({ id, label, icon: Icon }) => (
        <button
          key={id}
          className={`nav-item ${page === id ? "nav-item-active" : ""}`}
          onClick={() => onSelect(id)}
          title={collapsed ? label : undefined}
        >
          <Icon size={18} strokeWidth={1.8} />
          {!collapsed && <span>{label}</span>}
        </button>
      ))}
    </div>
  );
}

export default App;
