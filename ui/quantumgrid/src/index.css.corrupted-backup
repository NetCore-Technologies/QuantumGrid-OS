  display: flex;
  align-items: center;
  gap: 10px;

  padding-top: 24px;
}

.mini-q {
  width: 37px;
  height: 37px;

  display: grid;
  place-items: center;

  border-radius: 10px;

  background:
    linear-gradient(135deg, #d72860, #3f72ef);

  font-weight: 950;
}

.setup-top-brand strong,
.setup-top-brand span {
  display: block;
}

.setup-top-brand strong {
