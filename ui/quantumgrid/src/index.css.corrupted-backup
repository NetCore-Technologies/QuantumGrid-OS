/* ---------- WAN FINAL SCREEN ---------- */

.wan-final-screen {
  width: 100vw;
  height: 100vh;
  min-height: 100dvh;

  position: fixed;
  inset: 0;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 78% 14%,
      rgba(63,114,255,.17),
      transparent 32%
    ),
    radial-gradient(
      circle at 10% 86%,
      rgba(213,34,89,.17),
      transparent 31%
    ),
    radial-gradient(
      circle at 51% 46%,
      rgba(128,66,210,.075),
      transparent 39%
    ),
    #05060b;
}

.wan-final-content {
  width: min(1080px, calc(100% - 50px));

  flex: 1 1 auto;

  margin: 0 auto;

  display: flex;
  flex-direction: column;
  justify-content: center;

  position: relative;
  z-index: 3;

  padding: 28px 0 105px;
}

.wan-final-heading {
  width: 100%;
  text-align: center;
}

.wan-hero-icon {
  width: 57px;
  height: 57px;

  display: grid;
  place-items: center;

  margin: 16px auto 0;

  border: 1px solid rgba(255,255,255,.07);
  border-radius: 17px;

  background:
    linear-gradient(
      135deg,
      rgba(213,34,89,.21),
      rgba(129,65,210,.1),
      rgba(63,114,255,.19)
    );

  box-shadow:
    0 0 55px rgba(63,114,255,.09);
}

.wan-final-heading h1 {
  max-width: 850px;

  margin: 17px auto 10px;

  font-size: clamp(37px, 4.6vw, 55px);
  line-height: .97;
  letter-spacing: -.058em;
}

.wan-final-heading h1 span {
  background:
    linear-gradient(
      90deg,
      #ff4b79,
      #a561ff 48%,
      #4d84ff
    );

  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.wan-final-heading p {
  max-width: 650px;

  margin: 0 auto;

  color: rgba(255,255,255,.4);

  font-size: 10px;
  line-height: 1.7;
}

.wan-options-premium {
  width: 100%;

  display: grid;
  grid-template-columns: repeat(3, 1fr);

  gap: 10px;

  margin-top: 31px;
}

.wan-card {
  min-height: 175px;

  position: relative;

  display: flex;
  flex-direction: column;
  align-items: flex-start;

  padding: 19px;

  border: 1px solid rgba(255,255,255,.065);
  border-radius: 16px;

  color: rgba(255,255,255,.6);

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.044),
      rgba(255,255,255,.012)
    );

  text-align: left;

  transition:
    transform 170ms ease,
    border-color 170ms ease,
    box-shadow 170ms ease,
    background 170ms ease;
}

.wan-card:hover {
  transform: translateY(-3px);
  color: white;
  border-color: rgba(255,255,255,.11);
}

.wan-card.selected {
  border-color: rgba(213,34,89,.28);

  color: white;

  background:
    linear-gradient(
      145deg,
      rgba(213,34,89,.14),
      rgba(78,55,160,.08),
      rgba(63,114,255,.09)
    );

  box-shadow:
    0 22px 55px rgba(0,0,0,.18),
    0 0 35px rgba(213,34,89,.07);
}

.wan-card-radio {
  position: absolute;
  right: 17px;
  top: 18px;

  width: 16px;
  height: 16px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(255,255,255,.2);
  border-radius: 50%;
}

.wan-card-radio span {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: linear-gradient(
    135deg,
    var(--red),
    var(--blue)
  );
}

.wan-card-icon {
  width: 40px;
  height: 40px;

  display: grid;
  place-items: center;

  border-radius: 11px;

  color: rgba(255,255,255,.71);

  background:
    linear-gradient(
      135deg,
      rgba(213,34,89,.16),
      rgba(63,114,255,.13)
    );
}

.wan-card-copy {
  margin-top: 22px;
}

.wan-card-copy strong,
.wan-card-copy span {
  display: block;
}

.wan-card-copy strong {
  font-size: 11px;
}

.wan-card-copy span {
  margin-top: 5px;

  max-width: 220px;

  color: rgba(255,255,255,.34);

  font-size: 8px;
  line-height: 1.55;
}

.wan-card em {
  position: absolute;
  bottom: 17px;
  left: 19px;

  color: rgba(255,255,255,.21);

  font-size: 7px;
  font-style: normal;
  font-weight: 900;
  letter-spacing: .13em;
}

.wan-card > svg {
  position: absolute;
  right: 17px;
  bottom: 16px;

  color: rgba(255,255,255,.21);
}

.wan-ready {
  width: 100%;

  display: flex;
  align-items: center;
  gap: 12px;

  margin-top: 13px;
  padding: 13px 15px;

  border: 1px solid rgba(255,255,255,.05);
  border-radius: 12px;

  background: rgba(255,255,255,.018);
}

.wan-ready-icon {
  width: 31px;
  height: 31px;

  display: grid;
  place-items: center;

  flex: 0 0 auto;

  border-radius: 9px;

  color: #a97aff;
  background: rgba(125,79,204,.09);
}

.wan-ready strong,
.wan-ready span {
  display: block;
}

.wan-ready strong {
  font-size: 9px;
}

.wan-ready span {
  margin-top: 3px;

  color: rgba(255,255,255,.29);

  font-size: 7px;
}

