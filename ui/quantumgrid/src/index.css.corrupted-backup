:root {
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;

  color: #f7f8fb;
  background: #05060a;

  font-synthesis: none;
  text-rendering: optimizeLegibility;

  --bg: #05060a;
  --panel: rgba(14, 15, 23, 0.82);
  --panel-strong: rgba(18, 19, 29, 0.94);

  --white: #ffffff;
  --text: #f5f6fa;
  --muted: rgba(255, 255, 255, 0.52);
  --muted-2: rgba(255, 255, 255, 0.34);

  --red: #d52259;
  --red-bright: #ef2f67;
  --blue: #3e72ff;
  --blue-bright: #5a8aff;

  --border: rgba(255, 255, 255, 0.075);

  font-synthesis: none;
}

* {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  background: var(--bg);
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(circle at 82% 8%, rgba(51, 91, 255, 0.14), transparent 30%),
    radial-gradient(circle at 8% 22%, rgba(205, 20, 76, 0.12), transparent 28%),
    var(--bg);
  color: var(--text);
  overflow-x: hidden;
}

button {
  font: inherit;
}

button:focus-visible {
  outline: 2px solid rgba(90, 138, 255, 0.85);
  outline-offset: 2px;
}

.app {
  min-height: 100vh;
}

.ambient {
  position: fixed;
  pointer-events: none;
  z-index: 0;
  filter: blur(100px);
  opacity: 0.12;
}

.ambient-red {
  width: 420px;
  height: 420px;
  left: -160px;
  top: 120px;
  background: #d52259;
}

.ambient-blue {
  width: 440px;
  height: 440px;
  right: -150px;
  top: 20px;
  background: #3e72ff;
}

.sidebar {
  width: 248px;
  height: 100vh;
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 50;

  display: flex;
  flex-direction: column;

  border-right: 1px solid var(--border);

  background:
    linear-gradient(
      180deg,
      rgba(18, 10, 17, 0.98),
      rgba(7, 8, 13, 0.99)
    );

  backdrop-filter: blur(20px);
}

.brand {
  min-height: 84px;
  padding: 20px 18px;

  display: flex;
  align-items: center;
  gap: 12px;

  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.brand-logo {
  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  border-radius: 12px;

  background:
    linear-gradient(135deg, var(--red), #9f173f 42%, var(--blue));

  font-weight: 950;
  font-size: 21px;

  box-shadow:
    0 0 28px rgba(213, 34, 89, 0.26),
    0 0 34px rgba(62, 114, 255, 0.16);
}

.brand-name {
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.17em;
}

.brand-subtitle {
  margin-top: 4px;
  font-size: 9px;
  letter-spacing: 0.22em;
  color: var(--muted-2);
}

.mobile-close {
  display: none;
  margin-left: auto;
  border: 0;
  background: transparent;
  color: var(--muted);
}

.side-scroll {
  flex: 1;
  overflow: auto;
  padding: 18px 12px;
}

.nav {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.nav-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.nav-title {
  padding: 0 11px 8px;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.19em;
  color: var(--muted-2);
  text-transform: uppercase;
}

.nav-item {
  width: 100%;
  min-height: 42px;

  display: flex;
  align-items: center;
  gap: 12px;

  padding: 10px 11px;

  border: 1px solid transparent;
  border-radius: 10px;

  background: transparent;
  color: rgba(255, 255, 255, 0.55);

  text-align: left;
  cursor: pointer;

  transition:
    transform 160ms ease,
    color 160ms ease,
    background 160ms ease,
    border-color 160ms ease,
    box-shadow 160ms ease;
}

.nav-item:hover {
  color: var(--white);
  background: rgba(255, 255, 255, 0.035);
  transform: translateX(2px);
}

.nav-item-active {
  color: var(--white);
  background:
    linear-gradient(
      90deg,
      rgba(213, 34, 89, 0.22),
      rgba(62, 114, 255, 0.08)
    );
  border-color: rgba(213, 34, 89, 0.17);
  box-shadow:
    inset 3px 0 0 var(--red),
    0 12px 30px rgba(0, 0, 0, 0.12);
}

.sidebar-bottom {
  padding: 14px;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.router-card {
  min-height: 64px;

  display: flex;
  align-items: center;
  gap: 10px;

  padding: 11px;

  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 13px;

  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.045),
      rgba(255, 255, 255, 0.015)
    );
}

.router-icon {
  width: 36px;
  height: 36px;

  display: grid;
  place-items: center;

  border-radius: 10px;

  background: linear-gradient(
    135deg,
    rgba(213, 34, 89, 0.19),
    rgba(62, 114, 255, 0.17)
  );
}

.router-card strong,
.router-card span {
  display: block;
}

.router-card strong {
  font-size: 12px;
}

.router-card span {
  margin-top: 3px;
  font-size: 8px;
  letter-spacing: 0.14em;
  color: var(--muted-2);
}

.router-card > .status-dot {
  margin-left: auto;
}

.status-dot {
  width: 7px;
  height: 7px;
  display: inline-block;
  border-radius: 999px;
  background: #545967;
}

.status-dot-active {
  background: #37dc95;
  box-shadow: 0 0 12px rgba(55, 220, 149, 0.72);
  animation: pulse 1.9s infinite;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  min-height: 25px;
  padding: 5px 9px;

  border: 1px solid rgba(255, 255, 255, 0.065);
  border-radius: 999px;

  background: rgba(255, 255, 255, 0.035);

  font-size: 8px;
  font-weight: 900;
  letter-spacing: 0.12em;
  color: rgba(255, 255, 255, 0.66);

  white-space: nowrap;
}

.main {
  width: calc(100% - 248px);
  margin-left: 248px;
  position: relative;
  z-index: 1;
}

.topbar {
  height: 70px;

  padding: 0 28px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  position: sticky;
  top: 0;
  z-index: 40;

  border-bottom: 1px solid rgba(255, 255, 255, 0.06);

  background: rgba(5, 6, 10, 0.78);
  backdrop-filter: blur(18px);
}

.topbar-left,
.topbar-right {
  display: flex;
  align-items: center;
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 7px;

  color: var(--muted-2);

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.breadcrumb span {
  color: rgba(255, 255, 255, 0.72);
}

.topbar-right {
  gap: 10px;
}

.topbar-time {
  min-width: 74px;
  text-align: right;

  font-size: 11px;
  color: var(--muted);

  font-variant-numeric: tabular-nums;
}

.icon-button,
.mobile-menu {
  width: 34px;
  height: 34px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 9px;

  background: rgba(255, 255, 255, 0.03);
  color: var(--muted);

  cursor: pointer;

  transition:
    background 160ms ease,
    color 160ms ease,
    transform 160ms ease;
}

.icon-button:hover,
.mobile-menu:hover {
  color: white;
  background: rgba(255, 255, 255, 0.06);
  transform: translateY(-1px);
}

.mobile-menu {
  display: none;
  margin-right: 10px;
}

.content {
  padding: 30px;
  max-width: 1800px;
  margin: 0 auto;
}

.page-stack {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.page-enter {
  animation: pageEnter 260ms ease both;
}

.hero-card {
  min-height: 285px;
  position: relative;
  overflow: hidden;

  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 24px;

  padding: 34px;

  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 20px;

  background:
    radial-gradient(circle at 78% 22%, rgba(63, 114, 255, 0.17), transparent 32%),
    radial-gradient(circle at 22% 80%, rgba(213, 34, 89, 0.17), transparent 34%),
    linear-gradient(130deg, rgba(18, 9, 16, 0.93), rgba(10, 11, 18, 0.95));

  box-shadow:
    0 40px 100px rgba(0, 0, 0, 0.22),
    inset 0 1px 0 rgba(255, 255, 255, 0.035);
}

.hero-card::before {
  content: "";
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      120deg,
      transparent 0 35%,
      rgba(255, 255, 255, 0.025) 42%,
      transparent 52%
    );

  transform: translateX(-100%);
  animation: shine 8s ease-in-out infinite;
}

.hero-grid {
  position: absolute;
  inset: 0;

  background-image:
    linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);

  background-size: 34px 34px;
  mask-image: linear-gradient(to right, black, transparent 78%);
  opacity: 0.65;
}

.hero-content {
  position: relative;
  z-index: 2;
  align-self: center;
}

.eyebrow {
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.19em;
  color: rgba(255, 255, 255, 0.4);
}

.hero-content h1 {
  max-width: 820px;
  margin: 12px 0 11px;

  font-size: clamp(34px, 4vw, 54px);
  line-height: 0.98;
  letter-spacing: -0.055em;
}

.hero-content h1 span {
  display: inline;
  background: linear-gradient(90deg, #ff4b79, #9e6bff 45%, #4b83ff 85%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-content p {
  max-width: 730px;
  margin: 0;

  color: var(--muted);
  line-height: 1.68;
  font-size: 13px;
}

.hero-actions {
  display: flex;
  gap: 10px;
  margin-top: 23px;
}

.primary-button,
.secondary-button {
  min-height: 42px;

  display: inline-flex;
  align-items: center;
  gap: 8px;

  border-radius: 10px;
  padding: 0 15px;

  cursor: pointer;

  transition:
    transform 160ms ease,
    box-shadow 160ms ease,
    border-color 160ms ease;
}

.primary-button {
  border: 0;
  color: white;
  font-weight: 800;

  background: linear-gradient(135deg, #c91e55, #8b2147 48%, #315fe0);

  box-shadow:
    0 12px 28px rgba(197, 29, 82, 0.2),
    0 10px 28px rgba(54, 86, 206, 0.14);
}

.secondary-button {
  border: 1px solid rgba(255, 255, 255, 0.09);
  background: rgba(255, 255, 255, 0.035);
  color: rgba(255, 255, 255, 0.78);
}

.primary-button:hover,
.secondary-button:hover {
  transform: translateY(-2px);
}

.hero-status-card {
  position: relative;
  z-index: 2;
  align-self: stretch;

  padding: 22px;

  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 16px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.055),
      rgba(255, 255, 255, 0.018)
    );

  backdrop-filter: blur(14px);
}

.hero-status-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;

  font-size: 8px;
  letter-spacing: 0.16em;
  color: var(--muted-2);
}

.hero-status-score {
  margin-top: 34px;

  font-size: 66px;
  line-height: 0.9;
  font-weight: 900;
  letter-spacing: -0.06em;

  background: linear-gradient(135deg, #ff416f, #8f64ff, #447bff);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-status-caption {
  margin-top: 9px;
  font-size: 11px;
  color: var(--muted);
}

.hero-mini-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-top: 24px;
}

.hero-mini-stats div {
  padding-top: 10px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.hero-mini-stats span,
.hero-mini-stats strong {
  display: block;
}

.hero-mini-stats span {
  font-size: 8px;
  color: var(--muted-2);
}

.hero-mini-stats strong {
  margin-top: 4px;
  font-size: 11px;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.metric-card {
  min-height: 126px;

  display: flex;
  gap: 14px;
  align-items: flex-start;

  padding: 19px;

  border: 1px solid var(--border);
  border-radius: 15px;

  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.045),
      rgba(255, 255, 255, 0.017)
    );

  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease;
}

.metric-card:hover {
  transform: translateY(-3px);
  border-color: rgba(255, 255, 255, 0.12);
}

.metric-icon {
  width: 40px;
  height: 40px;

  display: grid;
  place-items: center;

  border-radius: 11px;

  background:
    linear-gradient(
      135deg,
      rgba(213, 34, 89, 0.2),
      rgba(62, 114, 255, 0.16)
    );

  color: rgba(255, 255, 255, 0.84);
}

.metric-title {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.15em;
  color: var(--muted-2);
}

.metric-value {
  margin-top: 5px;

  font-size: 27px;
  line-height: 1;

  font-weight: 900;
  letter-spacing: -0.045em;
}

.metric-value span {
  font-size: 11px;
  color: var(--muted);
  font-weight: 700;
}

.metric-detail {
  margin-top: 8px;
  font-size: 9px;
  color: var(--muted-2);
}

.two-column {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(320px, 0.95fr);
  gap: 14px;
}

.three-column {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14px;
}

.panel {
  min-height: 100px;

  padding: 22px;

  border: 1px solid var(--border);
  border-radius: 16px;

  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.042),
      rgba(255, 255, 255, 0.015)
    );

  box-shadow:
    0 24px 70px rgba(0, 0, 0, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.025);
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
}

.panel-eyebrow {
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 0.17em;
  color: var(--muted-2);
}

.panel h2 {
  margin: 7px 0 0;
  font-size: 19px;
  line-height: 1.1;
  letter-spacing: -0.035em;
}

.large-panel {
  min-height: 455px;
}

.traffic-summary {
  display: flex;
  gap: 24px;
  margin-top: 24px;
}

.traffic-summary span,
.traffic-summary strong {
  display: block;
}

.traffic-summary span {
  font-size: 8px;
  color: var(--muted-2);
  letter-spacing: 0.14em;
}

.traffic-summary strong {
  margin-top: 5px;
  font-size: 19px;
}

.chart-wrap {
  width: 100%;
  height: 310px;
  margin-top: 18px;
}

.chart-legend {
  display: flex;
  gap: 18px;
  margin-top: 5px;

  color: var(--muted-2);
  font-size: 9px;
}

.chart-legend span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.chart-legend i {
  width: 7px;
  height: 7px;
  display: inline-block;
  border-radius: 999px;
}

.legend-red {
  background: var(--red);
}

.legend-blue {
  background: var(--blue);
}

.gaming-panel {
  min-height: 455px;
}

.gaming-score-row {
  margin-top: 28px;

  display: grid;
  grid-template-columns: 170px 1fr;
  gap: 22px;
  align-items: center;
}

.gaming-ring {
  width: 160px;
  height: 160px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background:
    conic-gradient(
      #d9225b 0 34%,
      #7d53d8 34% 74%,
      #3e72ff 74% 98%,
      rgba(255, 255, 255, 0.07) 98% 100%
    );

  box-shadow:
    0 0 50px rgba(213, 34, 89, 0.13),
    0 0 52px rgba(62, 114, 255, 0.11);
}

.gaming-ring-inner {
  width: 126px;
  height: 126px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background: #0b0c12;

  box-shadow: inset 0 0 28px rgba(0, 0, 0, 0.4);
}

.gaming-ring-inner strong {
  font-size: 36px;
  letter-spacing: -0.06em;
}

.gaming-ring-inner span {
  margin-left: 3px;
  font-size: 10px;
  color: var(--muted-2);
}

.gaming-stat-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.gaming-stat-list div {
  padding: 11px;

  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.025);
}

.gaming-stat-list span,
.gaming-stat-list strong {
  display: block;
}

.gaming-stat-list span {
  font-size: 8px;
  color: var(--muted-2);
  text-transform: uppercase;
  letter-spacing: 0.11em;
}

.gaming-stat-list strong {
  margin-top: 5px;
  font-size: 14px;
}

.mode-selector {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 7px;

  margin-top: 26px;
  padding: 5px;

  border-radius: 11px;

  background: rgba(255, 255, 255, 0.025);
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.mode-selector button {
  min-height: 34px;

  border: 1px solid transparent;
  border-radius: 8px;

  background: transparent;
  color: var(--muted-2);

  font-size: 9px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.09em;

  cursor: pointer;

  transition: all 150ms ease;
}

.mode-selector button:hover {
  color: white;
}

.mode-selector .mode-active {
  color: white;

  background:
    linear-gradient(
      90deg,
      rgba(213, 34, 89, 0.25),
      rgba(62, 114, 255, 0.13)
    );

  border-color: rgba(213, 34, 89, 0.18);
}

.mode-description {
  min-height: 42px;
  margin-top: 12px;

  display: flex;
  align-items: center;
  gap: 9px;

  padding: 0 12px;

  border-radius: 10px;

  color: var(--muted);
  background: rgba(255, 255, 255, 0.025);

  font-size: 10px;
}

.accel-list {
  margin-top: 20px;
}

.accel-list > div {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 10px 0;

  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.accel-list > div:last-child {
  border-bottom: 0;
}

.accel-list > div > span:first-child {
  color: rgba(255, 255, 255, 0.62);
  font-size: 11px;
}

.health-grid {
  margin-top: 20px;

  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 7px;
}

.health-grid > div {
  min-height: 90px;

  padding: 12px;

  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 10px;

  background: rgba(255, 255, 255, 0.024);
}

.health-grid svg {
  width: 16px;
  opacity: 0.55;
}

.health-grid span,
.health-grid strong {
  display: block;
}

.health-grid span {
  margin-top: 12px;
  font-size: 7px;
  letter-spacing: 0.12em;
  color: var(--muted-2);
}

.health-grid strong {
  margin-top: 4px;
  font-size: 13px;
}

.connectivity-list {
  margin-top: 14px;
}

.connectivity-list > div {
  min-height: 44px;

  display: grid;
  grid-template-columns: 22px 1fr auto;
  align-items: center;
  gap: 8px;

  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.connectivity-list > div:last-child {
  border-bottom: 0;
}

.connectivity-list svg {
  width: 17px;
  color: rgba(255, 255, 255, 0.5);
}

.connectivity-list span {
  color: rgba(255, 255, 255, 0.62);
  font-size: 10px;
}

.device-table {
  margin-top: 20px;
}

.device-row {
  display: grid;
  grid-template-columns: 2fr 1.1fr 0.9fr 0.9fr 0.8fr;
  gap: 18px;

  min-height: 72px;
  padding: 13px 0;

  align-items: center;

  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.device-row:last-child {
  border-bottom: 0;
}

.device-name {
  display: flex;
  align-items: center;
  gap: 11px;
}

.device-avatar {
  width: 37px;
  height: 37px;

  display: grid;
  place-items: center;

  border-radius: 10px;

  background:
    linear-gradient(
      135deg,
      rgba(213, 34, 89, 0.17),
      rgba(62, 114, 255, 0.13)
    );
}

.device-name strong,
.device-name span {
  display: block;
}

.device-name strong {
  font-size: 11px;
}

.device-name span {
  margin-top: 3px;
  font-size: 8px;
  color: var(--muted-2);
}

.table-label {
  display: block;

  font-size: 7px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--muted-2);
}

.device-row > div > strong:not(.priority) {
  display: block;
  margin-top: 4px;
  font-size: 10px;
}

.priority {
  display: inline-block;
  margin-top: 4px;
  color: #f05a83;
  font-size: 9px;
  letter-spacing: 0.08em;
}

.panel-link {
  display: inline-flex;
  align-items: center;
  gap: 2px;

  border: 0;
  background: transparent;
  color: var(--muted);

  font-size: 9px;
  cursor: pointer;
}

.panel-link:hover {
  color: white;
}

.module-banner {
  display: flex;
  gap: 15px;
  align-items: flex-start;

  padding: 25px;

  border: 1px solid var(--border);
  border-radius: 17px;

  background:
    radial-gradient(circle at 82% 20%, rgba(62, 114, 255, 0.12), transparent 34%),
    radial-gradient(circle at 15% 80%, rgba(213, 34, 89, 0.1), transparent 30%),
    rgba(12, 13, 19, 0.82);
}

.module-icon {
  width: 50px;
  height: 50px;

  display: grid;
  place-items: center;

  border-radius: 13px;

  background:
    linear-gradient(
      135deg,
      rgba(213, 34, 89, 0.23),
      rgba(62, 114, 255, 0.18)
    );
}

.module-banner h1 {
  margin: 7px 0 6px;
  font-size: 34px;
  letter-spacing: -0.045em;
}

.module-banner p {
  margin: 0;
  max-width: 760px;
  color: var(--muted);
  line-height: 1.6;
  font-size: 11px;
}

.module-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 14px;
}

.module-placeholder-stat {
  min-height: 160px;

  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 17px;

  text-align: center;
}

.module-placeholder-stat strong {
  font-size: 15px;
  color: rgba(255, 255, 255, 0.65);
}

.control-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;

  margin-top: 20px;
}

.control-tile {
  min-height: 100px;

  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  gap: 10px;

  padding: 16px;

  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 12px;

  background: rgba(255, 255, 255, 0.025);
  color: rgba(255, 255, 255, 0.65);

  cursor: pointer;

  transition:
    transform 160ms ease,
    border-color 160ms ease,
    background 160ms ease;
}

.control-tile:hover {
  transform: translateY(-2px);
  color: white;
  border-color: rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.05);
}

.control-tile span {
  font-size: 10px;
  font-weight: 800;
}

.footer {
  display: flex;
  justify-content: space-between;

  padding: 18px 30px 28px;

  font-size: 8px;
  letter-spacing: 0.14em;
  color: rgba(255, 255, 255, 0.22);
}

.glow-border {
  position: relative;
}

.glow-border::after {
  content: "";
  position: absolute;
  inset: -1px;

  border-radius: inherit;

  background:
    linear-gradient(
      135deg,
      rgba(213, 34, 89, 0.13),
      transparent 32%,
      transparent 68%,
      rgba(62, 114, 255, 0.1)
    );

  pointer-events: none;
  z-index: -1;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }

  50% {
    opacity: 0.58;
    transform: scale(0.82);
  }
}

@keyframes shine {
  0%,
  72% {
    transform: translateX(-100%);
  }

  92%,
  100% {
    transform: translateX(120%);
  }
}

@keyframes pageEnter {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 1250px) {
  .hero-card {
    grid-template-columns: 1fr;
  }

  .hero-status-card {
    min-height: 190px;
  }

  .metrics-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .three-column {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 1000px) {
  .sidebar {
    transform: translateX(-102%);
    transition: transform 220ms ease;
    box-shadow: 25px 0 90px rgba(0, 0, 0, 0.35);
  }

  .sidebar-open {
    transform: translateX(0);
  }

  .mobile-close,
  .mobile-menu {
    display: grid;
  }

  .main {
    width: 100%;
    margin-left: 0;
  }

  .two-column,
  .module-grid {
    grid-template-columns: 1fr;
  }

  .device-row {
    grid-template-columns: 2fr repeat(4, 1fr);
  }
}

@media (max-width: 760px) {
  .content {
    padding: 18px;
  }

  .topbar {
    padding: 0 18px;
  }

  .topbar-system {
    display: none;
  }

  .hero-card {
    padding: 23px;
  }

  .hero-content h1 {
    font-size: 36px;
  }

  .hero-actions {
    flex-direction: column;
  }

  .primary-button,
  .secondary-button {
    justify-content: center;
  }

  .metrics-grid {
    grid-template-columns: 1fr;
  }

  .gaming-score-row {
    grid-template-columns: 1fr;
    justify-items: center;
  }

  .gaming-stat-list {
    width: 100%;
  }

  .device-row {
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .device-name {
    grid-column: 1 / -1;
  }

  .footer {
    padding: 12px 18px 22px;
    gap: 10px;
    flex-wrap: wrap;
  }
}

/* ============================================================
   QUANTUMGRID PREMIUM FIRST-BOOT EXPERIENCE
   ============================================================ */

