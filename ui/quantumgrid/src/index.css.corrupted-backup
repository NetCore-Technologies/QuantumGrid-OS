/* ERROR MODAL */

.error-overlay {
  position: fixed;
  inset: 0;

  z-index: 100;

  display: grid;
  place-items: center;
}

.error-backdrop {
  position: absolute;
  inset: 0;

  background: rgba(0,0,0,.64);
  backdrop-filter: blur(10px);

  animation: fadeIn 150ms ease both;
}

.error-modal {
  width: min(430px, calc(100% - 30px));

  position: relative;
  z-index: 2;

  padding: 27px;

  border: 1px solid rgba(255,255,255,.09);
  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      rgba(24,14,23,.98),
      rgba(8,11,17,.99)
    );

  box-shadow:
    0 45px 120px rgba(0,0,0,.5),
    0 0 0 1px rgba(213,34,89,.035),
    inset 0 1px 0 rgba(255,255,255,.04);

  animation: modalIn 190ms cubic-bezier(.2,.8,.2,1) both;
}

.error-close {
  position: absolute;
  top: 12px;
  right: 12px;

  width: 32px;
  height: 32px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(255,255,255,.06);
  border-radius: 8px;

  color: rgba(255,255,255,.42);
  background: rgba(255,255,255,.025);
}

.error-close:hover {
  color: white;
  background: rgba(255,255,255,.06);
}

.error-icon {
  width: 45px;
  height: 45px;

  display: grid;
  place-items: center;

  border-radius: 12px;

  color: #ff7195;

  background: rgba(213,34,89,.11);
  border: 1px solid rgba(213,34,89,.16);
}

.error-eyebrow {
  margin-top: 19px;

  color: rgba(255,255,255,.32);

  font-size: 8px;
  font-weight: 900;
  letter-spacing: .18em;
}

.error-modal h2 {
  margin: 8px 0;

  font-size: 25px;
  letter-spacing: -.035em;
}

.error-modal p {
  margin: 0;

  color: rgba(255,255,255,.48);

  font-size: 10px;
  line-height: 1.65;
}

.error-action {
  width: 100%;
  min-height: 40px;

  margin-top: 20px;

  border: 0;
  border-radius: 9px;

  color: white;

  background: linear-gradient(100deg, #c91f56, #416fe9);

  font-size: 9px;
  font-weight: 850;
}

/* ANIMATION */

@keyframes qFloat {
  0%, 100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-6px);
  }
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: translateY(12px) scale(.97);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

