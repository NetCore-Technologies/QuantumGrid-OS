#!/bin/sh
# QuantumGrid AW1000 hardware I/O inspection.
# Read-only: never changes GPIO direction/value or LED brightness/trigger.

set -eu

usage() {
  cat <<'USAGE'
QuantumGrid hardware I/O inspector (read-only)

Usage:
  sh /usr/bin/quantumgrid-hardware-io [all|gpio|buttons|leds]

Commands:
  all       Show GPIO, button-like labels and LED class devices (default)
  gpio      Show the kernel GPIO debugfs inventory
  buttons   Filter GPIO labels/consumers for button-like names
  leds      Show Linux LED-class brightness and trigger metadata

This utility does not drive GPIO outputs or change LED settings.
USAGE
}

show_gpio() {
  if [ ! -r /sys/kernel/debug/gpio ]; then
    echo "GPIO debugfs is unavailable (not mounted or not enabled)."
    return 0
  fi
  echo "=== Kernel GPIO inventory (read-only) ==="
  cat /sys/kernel/debug/gpio
}

show_buttons() {
  echo "=== Native GPIO button event support (read-only) ==="
  if [ -d /sys/module/gpio_button_hotplug ]; then
    echo "gpio-button-hotplug driver: present"
  else
    echo "gpio-button-hotplug driver: not detected (it may be built in or unavailable)"
  fi
  if [ -d /etc/rc.button ]; then
    echo "Native /etc/rc.button handlers:"
    found=0
    for handler in /etc/rc.button/*; do
      [ -f "$handler" ] || continue
      found=1
      printf '  %s\n' "${handler##*/}"
    done
    [ "$found" -eq 1 ] || echo "  no named handlers found"
  else
    echo "Native /etc/rc.button directory is unavailable."
  fi
  if [ -r /proc/bus/input/devices ]; then
    echo "=== Linux input device names and event handlers ==="
    awk '/^N: Name=|^H: Handlers=/{print}' /proc/bus/input/devices
  else
    echo "Linux input-device inventory is unavailable."
  fi
  if [ -r /sys/kernel/debug/gpio ]; then
    echo "=== Button-like GPIO labels/consumers (name hints only) ==="
    if ! grep -Ei 'button|reset|wps|power|key|wlan' /sys/kernel/debug/gpio; then
      echo "No button-like labels were reported by the kernel."
    fi
  else
    echo "GPIO debugfs is not readable; button-like GPIO labels are unavailable."
  fi
  echo "=== Read-only procd button-event monitor ==="
  if [ -r /var/run/quantumgrid/button-events.monitor ]; then
    echo "Monitor: subscribed to hotplug.button"
  else
    echo "Monitor: unavailable or waiting for procd"
  fi
  if [ -r /var/run/quantumgrid/button-events.tsv ]; then
    echo "Recent events (timestamp, button, action, SEEN seconds, type, sequence):"
    tail -n 10 /var/run/quantumgrid/button-events.tsv | awk -F '|' 'NF == 6 { printf "  %s  %s  %s  SEEN=%ss  %s  #%s\\n", $1, $3, $4, $5, $6, $2 }'
  else
    echo "No button events have been captured since this boot."
  fi
  echo "Events are observed through procd ubus notifications; native /etc/rc.button handlers are not intercepted."
}

show_leds() {
  if [ ! -d /sys/class/leds ]; then
    echo "Linux LED class is unavailable."
    return 0
  fi
  echo "=== Linux LED class inventory (read-only) ==="
  found=0
  for led in /sys/class/leds/*; do
    [ -d "$led" ] || continue
    found=1
    name=${led##*/}
    printf '\n%s\n' "$name"
    if [ -r "$led/brightness" ]; then
      printf '  brightness: '
      cat "$led/brightness"
    else
      echo "  brightness: unavailable"
    fi
    if [ -r "$led/max_brightness" ]; then
      printf '  max_brightness: '
      cat "$led/max_brightness"
    else
      echo "  max_brightness: unavailable"
    fi
    if [ -r "$led/trigger" ]; then
      printf '  trigger: '
      cat "$led/trigger"
    else
      echo "  trigger: unavailable"
    fi
  done
  [ "$found" -eq 1 ] || echo "No LED class devices were found."
}

command=${1:-all}
case "$command" in
  all)
    show_gpio
    show_buttons
    show_leds
    ;;
  gpio)
    show_gpio
    ;;
  buttons)
    show_buttons
    ;;
  leds)
    show_leds
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
