#!/bin/sh
# Expose the administrator interface only over encrypted HTTPS.
# Remove every default plaintext HTTP listener; do not rely on redirects alone.
set -eu

if uci -q get uhttpd.main.listen_http >/dev/null 2>&1; then
  uci -q delete uhttpd.main.listen_http
fi
uci -q set uhttpd.main.redirect_https=1
uci -q commit uhttpd

exit 0
