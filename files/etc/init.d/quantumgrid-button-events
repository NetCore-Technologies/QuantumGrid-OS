#!/bin/sh /etc/rc.common
# Passive procd button-event observer. Native hotplug handlers stay untouched.

START=97
STOP=10
USE_PROCD=1

start_service() {
  command -v ubus >/dev/null 2>&1 || return 1
  command -v jsonfilter >/dev/null 2>&1 || return 1
  [ -r /usr/bin/quantumgrid-button-events ] || return 1

  procd_open_instance
  procd_set_param command /bin/sh /usr/bin/quantumgrid-button-events
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

stop_service() {
  rm -f /var/run/quantumgrid/button-events.monitor
}
