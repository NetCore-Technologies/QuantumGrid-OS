#!/bin/sh /etc/rc.common
START=98
STOP=12
USE_PROCD=1
start_service() {
  [ -x /usr/bin/quantumgrid-radio-scheduler ] || return 1
  procd_open_instance
  procd_set_param command /usr/bin/quantumgrid-radio-scheduler
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
