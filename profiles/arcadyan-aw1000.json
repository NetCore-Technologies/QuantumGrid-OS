{
  "schema_version": 1,
  "platform": {
    "id": "arcadyan-aw1000",
    "vendor": "Arcadyan",
    "model": "AW1000",
    "openwrt_device": "arcadyan_aw1000",
    "openwrt_target": "qualcommax",
    "openwrt_subtarget": "ipq807x",
    "config_file": "configs/aw1000-max.config",
    "board_compatible": [
      "arcadyan,aw1000"
    ]
  },
  "capabilities": {
    "nss": {
      "supported": true,
      "config_fragment": "configs/aw1000-nss.fragment",
      "feed_pins": "configs/aw1000-nss-feeds.conf",
      "pin_script": "scripts/pin-aw1000-nss-feeds.sh",
      "required_config_symbols": [
        "CONFIG_ATH11K_NSS_SUPPORT=y",
        "CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y",
        "CONFIG_NSS_FIRMWARE_VERSION_12_5=y",
        "CONFIG_PACKAGE_kmod-qca-nss-drv=y",
        "CONFIG_PACKAGE_kmod-qca-nss-ecm=y",
        "CONFIG_PACKAGE_kmod-qca-nss-dp=y",
        "CONFIG_PACKAGE_kmod-qca-ssdk=y",
        "CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y",
        "CONFIG_PACKAGE_nss-firmware-ipq807x=y",
        "CONFIG_PACKAGE_kmod-qca-mcs=y",
        "CONFIG_PACKAGE_sqm-scripts-nss=y",
        "CONFIG_ATH11K_MEM_PROFILE_1G=y",
        "CONFIG_NSS_MEM_PROFILE_HIGH=y",
        "CONFIG_NSS_DRV_BRIDGE_ENABLE=y",
        "CONFIG_NSS_DRV_IPV6_ENABLE=y",
        "CONFIG_NSS_DRV_PPPOE_ENABLE=y",
        "CONFIG_NSS_DRV_VLAN_ENABLE=y",
        "CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y",
        "CONFIG_NSS_DRV_WIFI_EXT_VDEV_ENABLE=y"
      ]
    },
    "fxs": {
      "supported": true,
      "setup_script": "scripts/setup-aw1000-phone-feed.sh"
    }
  },
  "artifacts": {
    "output_directory": "qualcommax/ipq807x",
    "factory_glob": "*arcadyan_aw1000-squashfs-factory.ubi",
    "initramfs_glob": "*arcadyan_aw1000-initramfs-uImage.itb"
  }
}
